<UserControl x:Class="plomfX.Views.UserControls.CrosshairSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="320" d:DesignWidth="300">
    <Border Background="{DynamicResource PrimaryBackgroundBrush}" 
            BorderBrush="{DynamicResource PrimaryBorderBrush}" 
            BorderThickness="1" 
            CornerRadius="4"
            Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header with Back button -->
            <Grid Margin="0,0,0,10">
                <TextBlock Text="CROSSHAIR SETTINGS" 
                           Foreground="{DynamicResource SecondaryAccentBrush}" 
                           FontWeight="SemiBold" 
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>
                <Button x:Name="BackButton" 
                        Content="← Back" 
                        Style="{StaticResource ActionButtonStyle}" 
                        HorizontalAlignment="Right" 
                        Padding="8,4"/>
            </Grid>

            <StackPanel Grid.Row="1">
                <!-- Scale Section -->
                <StackPanel Margin="0,0,0,10">
                    <CheckBox x:Name="IndependentScaleCheckBox" 
                              Content="Independent X/Y Scaling" 
                              Foreground="White"
                              Margin="0,0,0,5"
                              Checked="IndependentScale_Changed" 
                              Unchecked="IndependentScale_Changed"/>

                    <!-- Unified scale -->
                    <StackPanel x:Name="UnifiedScalePanel">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Scale:" Foreground="White" Width="70"/>
                            <TextBlock x:Name="ScaleValueText" Foreground="White" Text="100%"/>
                        </StackPanel>
                        <Slider x:Name="ScaleSlider" Minimum="0.25" Maximum="3.0" Value="1.0"
                                TickFrequency="0.05" IsSnapToTickEnabled="True"
                                IsMoveToPointEnabled="True" SmallChange="0.05" LargeChange="0.25"/>
                    </StackPanel>

                    <!-- Independent X/Y -->
                    <StackPanel x:Name="IndependentScalePanel" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Scale X:" Foreground="White" Width="70"/>
                            <TextBlock x:Name="ScaleXValueText" Foreground="White" Text="100%"/>
                        </StackPanel>
                        <Slider x:Name="ScaleXSlider" Minimum="0.25" Maximum="3.0" Value="1.0"
                                TickFrequency="0.05" IsSnapToTickEnabled="True"
                                IsMoveToPointEnabled="True" SmallChange="0.05" LargeChange="0.25"/>

                        <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                            <TextBlock Text="Scale Y:" Foreground="White" Width="70"/>
                            <TextBlock x:Name="ScaleYValueText" Foreground="White" Text="100%"/>
                        </StackPanel>
                        <Slider x:Name="ScaleYSlider" Minimum="0.25" Maximum="3.0" Value="1.0"
                                TickFrequency="0.05" IsSnapToTickEnabled="True"
                                IsMoveToPointEnabled="True" SmallChange="0.05" LargeChange="0.25"/>
                    </StackPanel>
                </StackPanel>

                <!-- Opacity Slider -->
                <StackPanel Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Opacity:" Foreground="White" Width="60"/>
                        <TextBlock x:Name="OpacityValueText" Foreground="White" Text="100%"/>
                    </StackPanel>
                    <Slider x:Name="OpacitySlider" Minimum="0.1" Maximum="1.0" Value="1.0" 
                            TickFrequency="0.05" IsSnapToTickEnabled="True"
                            IsMoveToPointEnabled="True" SmallChange="0.05" LargeChange="0.25"/>
                </StackPanel>

                <!-- Color Tint -->
                <StackPanel Margin="0,0,0,10">
                    <TextBlock Text="Tint:" Foreground="White" Margin="0,0,0,5"/>
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="ResetColorButton" 
                                Content="↺ Reset" 
                                Width="60"
                                Padding="8,4" 
                                Style="{StaticResource ActionButtonStyle}"
                                Margin="0,0,8,0"/>
                        <Button x:Name="PickColorButton" 
                                Content="Choose Color..." 
                                Padding="8,4" 
                                Style="{StaticResource ActionButtonStyle}"/>
                        <Rectangle x:Name="ColorPreview" 
                                   Width="20" Height="20" 
                                   Fill="White" 
                                   Margin="12,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>