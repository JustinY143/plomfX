<UserControl x:Class="plomfX.Views.UserControls.CrosshairSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" 
             d:DesignHeight="400" d:DesignWidth="300">
    <Border Background="{DynamicResource PrimaryBackgroundBrush}" 
            BorderBrush="{DynamicResource PrimaryBorderBrush}" 
            BorderThickness="1" 
            CornerRadius="4"
            Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,10">
                <TextBlock Text="CROSSHAIR SETTINGS" 
                           Foreground="{DynamicResource SecondaryAccentBrush}" 
                           FontWeight="SemiBold" 
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"/>
                <Button x:Name="BackButton" 
                        Content="← Back" 
                        Style="{StaticResource ActionButtonStyle}" 
                        HorizontalAlignment="Right" 
                        Padding="8,4"/>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Independent Scale -->
                    <StackPanel Margin="0,0,0,10">
                        <CheckBox x:Name="IndependentScaleCheckBox" 
                                  Content="Independent X/Y Scaling" 
                                  Foreground="{DynamicResource PrimaryForegroundBrush}"
                                  Margin="0,0,0,5"/>

                        <StackPanel x:Name="UnifiedScalePanel">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Scale:" Foreground="{DynamicResource PrimaryForegroundBrush}" Width="70"/>
                                <TextBlock x:Name="ScaleValueText" Foreground="{DynamicResource PrimaryForegroundBrush}" Text="100%"/>
                            </StackPanel>
                            <Slider x:Name="ScaleSlider" Minimum="0.25" Maximum="3.0" Value="1.0"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    IsMoveToPointEnabled="True" SmallChange="0.05" LargeChange="0.25"/>
                        </StackPanel>

                        <StackPanel x:Name="IndependentScalePanel" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Scale X:" Foreground="{DynamicResource PrimaryForegroundBrush}" Width="70"/>
                                <TextBlock x:Name="ScaleXValueText" Foreground="{DynamicResource PrimaryForegroundBrush}" Text="100%"/>
                            </StackPanel>
                            <Slider x:Name="ScaleXSlider" Minimum="0.25" Maximum="3.0" Value="1.0"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    IsMoveToPointEnabled="True" SmallChange="0.05" LargeChange="0.25"/>

                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <TextBlock Text="Scale Y:" Foreground="{DynamicResource PrimaryForegroundBrush}" Width="70"/>
                                <TextBlock x:Name="ScaleYValueText" Foreground="{DynamicResource PrimaryForegroundBrush}" Text="100%"/>
                            </StackPanel>
                            <Slider x:Name="ScaleYSlider" Minimum="0.25" Maximum="3.0" Value="1.0"
                                    TickFrequency="0.05" IsSnapToTickEnabled="True"
                                    IsMoveToPointEnabled="True" SmallChange="0.05" LargeChange="0.25"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Opacity -->
                    <StackPanel Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Opacity:" Foreground="{DynamicResource PrimaryForegroundBrush}" Width="70"/>
                            <TextBlock x:Name="OpacityValueText" Foreground="{DynamicResource PrimaryForegroundBrush}" Text="100%"/>
                        </StackPanel>
                        <Slider x:Name="OpacitySlider" Minimum="0.1" Maximum="1.0" Value="1.0" 
                                TickFrequency="0.05" IsSnapToTickEnabled="True"
                                IsMoveToPointEnabled="True" SmallChange="0.05" LargeChange="0.25"/>
                    </StackPanel>

                    <!-- Offset -->
                    <StackPanel Margin="0,0,0,10">
                        <!-- Slider mode -->
                        <StackPanel x:Name="OffsetSliderPanel">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Offset (+/-):" Foreground="{DynamicResource PrimaryForegroundBrush}" Width="90"/>
                                <TextBlock x:Name="OffsetYValueText" Foreground="{DynamicResource PrimaryForegroundBrush}" Text="0 px"/>
                            </StackPanel>
                            <Slider x:Name="OffsetYSlider" Minimum="-150" Maximum="150" Value="0"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    IsMoveToPointEnabled="True" SmallChange="1" LargeChange="10"/>
                        </StackPanel>

                        <!-- Textbox mode -->
                        <StackPanel x:Name="OffsetTextPanel" Visibility="Collapsed" Orientation="Horizontal">
                            <TextBlock Text="Offset (+/-):" Foreground="{DynamicResource PrimaryForegroundBrush}" 
                                       Width="90" VerticalAlignment="Center"/>
                            <TextBox x:Name="OffsetYTextBox" 
                                     Width="60" 
                                     Text="0"
                                     TextAlignment="Right"
                                     Background="{DynamicResource SecondaryAccentBrush}"
                                     Foreground="{DynamicResource SecondaryForegroundBrush}"
                                     BorderThickness="0" Padding="4"/>
                            <TextBlock Text=" px" Foreground="{DynamicResource PrimaryForegroundBrush}" 
                                       VerticalAlignment="Center" Margin="4,0,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Color Tint -->
                    <StackPanel Margin="0,0,0,10">
                        <TextBlock Text="Tint:" Foreground="{DynamicResource PrimaryForegroundBrush}" Margin="0,0,0,5"/>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="ResetColorButton" 
                                    Content="↺ Reset" 
                                    Width="60"
                                    Padding="8,4" 
                                    Style="{StaticResource ActionButtonStyle}"
                                    Margin="0,0,8,0"/>
                            <Button x:Name="PickColorButton" 
                                    Content="Choose Color..." 
                                    Padding="8,4" 
                                    Style="{StaticResource ActionButtonStyle}"/>
                            <Rectangle x:Name="ColorPreview" 
                                       Width="20" Height="20" 
                                       Fill="White" 
                                       Margin="12,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</UserControl>